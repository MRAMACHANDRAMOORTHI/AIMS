{
  "info": {
    "_postman_id": "aims-erp-0002-4b00-9000-academicdomain",
    "name": "AIMS ERP · Academic Domain",
    "description": "**AIMS ERP — academic domain.**\n\nEverything inside a college's own PostgreSQL schema. Milestone 1 ships one table, `departments`, as the first slice of the Academic Structure context; programmes, courses, curricula and NAAC data follow in later milestones.\n\nOnboarding a college, its lifecycle and its migrations live in the separate **AIMS Platform** collection.\n\nThis collection is self-contained: folder 0 provisions its own two colleges through the platform API, so it can be run on a fresh database without the platform collection having been run first.\n\nEvery request outside folder 0 carries `x-tenant`, and operates only inside that college's schema.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:4000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "run_stamp",
      "value": "",
      "type": "string"
    },
    {
      "key": "erp_a_code",
      "value": "",
      "type": "string"
    },
    {
      "key": "erp_b_code",
      "value": "",
      "type": "string"
    },
    {
      "key": "erp_a_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "erp_b_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "dept_a_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "dept_b_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "dept_b_only_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Mint a fresh pair of college codes at the start of every run, so the",
          "// collection can be re-run against the same database without colliding",
          "// on the unique institution_code. 'Onboard College A' is the first request and",
          "// therefore marks the start of a run.",
          "if (pm.info.requestName === 'Onboard College A' || !pm.collectionVariables.get('run_stamp')) {",
          "  const stamp = String(Date.now()).slice(-7);",
          "  const set = (k, v) => { pm.collectionVariables.set(k, v); pm.environment.set(k, v); };",
          "  set('run_stamp', stamp);",
          "  set('erp_a_code', 'C-A' + stamp);",
          "  set('erp_b_code', 'C-B' + stamp);",
          "  set('erp_a_id', '');",
          "  set('erp_b_id', '');",
          "  set('dept_a_id', '');",
          "  set('dept_b_id', '');",
          "  set('dept_b_only_id', '');",
          "}",
          "",
          "// Authentication is not implemented in Milestone 1. The bearer token is",
          "// wired up so neither collection needs restructuring once auth lands."
        ]
      }
    }
  ],
  "item": [
    {
      "name": "0 · Setup",
      "description": "Provisions the two colleges this collection needs, so it can run on a fresh database without the Platform collection. Uses the platform API.",
      "item": [
        {
          "name": "Onboard College A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tenants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"institution_code\": \"{{erp_a_code}}\",\n  \"institution_name\": \"ABC Institute of Technology\",\n  \"institution_type\": \"ENGINEERING\",\n  \"autonomy_status\": \"AUTONOMOUS\"\n}"
            },
            "description": "Setup only. Two colleges are needed before any domain data can exist, and a second one is needed before isolation means anything."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('erp_a_id', d.id);",
                  "pm.environment.set('erp_a_id', d.id);",
                  "pm.test('ACTIVE and ready for domain data', () => {",
                  "  pm.expect(d.lifecycle_status).to.eql('ACTIVE');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Onboard College B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/tenants",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "tenants"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"institution_code\": \"{{erp_b_code}}\",\n  \"institution_name\": \"St Xavier College of Arts and Science\",\n  \"institution_type\": \"ARTS_SCIENCE\",\n  \"autonomy_status\": \"AFFILIATED\",\n  \"affiliating_university\": \"University of Madras\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('erp_b_id', d.id);",
                  "pm.environment.set('erp_b_id', d.id);",
                  "pm.test('ACTIVE', () => pm.expect(d.lifecycle_status).to.eql('ACTIVE'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 · Departments",
      "description": "The first slice of the Academic Structure context. Programmes and the course catalogue follow in Milestone 3.",
      "item": [
        {
          "name": "Create Department — College A",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_a_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"cse\",\n  \"name\": \"Department of Computer Science and Engineering\"\n}"
            },
            "description": "Created inside College A's schema. There is no `tenant_id` in the payload or the table — the schema boundary *is* the tenancy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('dept_a_id', d.id);",
                  "pm.environment.set('dept_a_id', d.id);",
                  "pm.test('code is upcased so casing cannot create duplicates', () => {",
                  "  pm.expect(d.code).to.eql('CSE');",
                  "});",
                  "pm.test('active by default', () => pm.expect(d.is_active).to.be.true);",
                  "pm.test('timestamps render in the college time zone', () => {",
                  "  pm.expect(d.inserted_at).to.match(/\\+05:30$/);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Department — College B, same code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_b_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CSE\",\n  \"name\": \"Department of Computer Science (B)\"\n}"
            },
            "description": "The same department code is free in a different college, because uniqueness is per schema. In a shared-table design with a `tenant_id` column this would need a compound unique constraint, and forgetting it is a classic leak."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created — the code is not globally unique', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('dept_b_id', d.id);",
                  "pm.environment.set('dept_b_id', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Department — College B only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_b_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"HIS\",\n  \"name\": \"Department of History\"\n}"
            },
            "description": "Gives College B an id that does not exist in College A at all.\n\nWithout this the isolation checks would be worthless: both colleges' first department is `id = 1`, because each schema has its own sequence, so a leak would still look like a successful fetch."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const d = pm.response.json().data;",
                  "pm.collectionVariables.set('dept_b_only_id', d.id);",
                  "pm.environment.set('dept_b_only_id', d.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List Departments — College A",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_a_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const codes = pm.response.json().data.map(d => d.code);",
                  "pm.test('sees only its own department', () => pm.expect(codes).to.eql(['CSE']));",
                  "pm.test('does not see College B HIS', () => pm.expect(codes).to.not.include('HIS'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List Departments — College B",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_b_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const codes = pm.response.json().data.map(d => d.code);",
                  "pm.test('sees its own two departments', () => {",
                  "  pm.expect(codes).to.have.members(['CSE', 'HIS']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Department",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_a_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments/{{dept_a_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments",
                "{{dept_a_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('is College A CSE', () => {",
                  "  pm.expect(pm.response.json().data.name)",
                  "    .to.eql('Department of Computer Science and Engineering');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Department",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_a_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments/{{dept_a_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments",
                "{{dept_a_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Department of Computer Science & Engineering\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('renamed', () => {",
                  "  pm.expect(pm.response.json().data.name)",
                  "    .to.eql('Department of Computer Science & Engineering');",
