              ]
            },
            "description": "Soft-deactivates. Departments are never hard-deleted — they own programmes and courses that carry accreditation evidence (invariant I-19)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('now inactive', () => {",
                  "  pm.expect(pm.response.json().data.is_active).to.be.false;",
