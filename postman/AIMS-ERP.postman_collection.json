      ]
    },
    {
      "name": "2 · Tenant Data Isolation",
      "description": "The security proof at the data layer. Every cross-college attempt must be refused, and College B's data must be untouched afterwards.",
      "item": [
        {
          "name": "College A cannot read a department that exists only in College B",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_a_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments/{{dept_b_only_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments",
                "{{dept_b_only_id}}"
              ]
            },
            "description": "This id exists in College B's schema and not in College A's, so a leak would surface here as a successful fetch."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('reports not_found', () => {",
                  "  pm.expect(pm.response.json().errors.code).to.eql('not_found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "A colliding id resolves to the caller's own row",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_b_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments/{{dept_a_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments",
                "{{dept_a_id}}"
              ]
            },
            "description": "Both colleges' first department shares an id, because each schema has its own sequence. Asserting only on found/not-found would pass even under a leak — the *contents* are what prove the boundary held."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK — College B has a row at this id too', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"it is College B's row, not College A's\", () => {",
                  "  pm.expect(pm.response.json().data.name).to.include('(B)');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "College A cannot update a College B department",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_a_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments/{{dept_b_only_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments",
                "{{dept_b_only_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hijacked\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('reports not_found', () => {",
                  "  pm.expect(pm.response.json().errors.code).to.eql('not_found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "College A cannot deactivate a College B department",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_a_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments/{{dept_b_only_id}}/deactivate",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments",
                "{{dept_b_only_id}}",
                "deactivate"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('reports not_found', () => {",
                  "  pm.expect(pm.response.json().errors.code).to.eql('not_found');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "College B's data is unaffected by any of it",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "x-tenant",
                "value": "{{erp_b_code}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/departments",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "departments"
              ]
            },
            "description": "Runs after every cross-tenant attempt above. If any had succeeded, this list would show it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
